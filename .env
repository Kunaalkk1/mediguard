PYTHONPATH=.
BROKER_HOST=127.0.0.1
BROKER_PORT=1883
ROOM_ID=room101
# Dashboard bind address: 0.0.0.0 = reachable from any device on the Pi's
# network (so mediguard.local works); 127.0.0.1 = localhost only.
MEDIGUARD_HOST=0.0.0.0
# Dashboard port. Open http://mediguard.local:7801 from any device on the LAN.
# (Port 80 would let you drop the :7801, but binding it needs root/sudo on the Pi.)
MEDIGUARD_PORT=7801
# Wi-Fi hotspot is retired: the Pi now joins your existing Wi-Fi/Ethernet and
# the dashboard is reachable at mediguard.local (see scripts/pi_setup.sh).
# Left here only so an old .env with MEDIGUARD_HOTSPOT=1 stays harmless.
MEDIGUARD_HOTSPOT=0
# PLANNER_MODE: online (Planning.Domains) | local (Fast Downward) | offline (built-in, no internet).
# online auto-falls back to offline if unreachable. When the Pi runs its own hotspot
# (no internet), set PLANNER_MODE=offline to avoid per-replan fallback delays.
PLANNER_MODE=online
PLANNER_FALLBACK_OFFLINE=1
PLANNING_SERVICE_URL=https://solver.planning.domains:5001/package/lama-first/solve