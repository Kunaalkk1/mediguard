PYTHONPATH=.
BROKER_HOST=127.0.0.1
BROKER_PORT=1883
ROOM_ID=room101
# Dashboard bind address: 0.0.0.0 = reachable from the Pi hotspot; 127.0.0.1 = localhost only
MEDIGUARD_HOST=0.0.0.0
MEDIGUARD_PORT=7801
# Wi-Fi hotspot on the Raspberry Pi (NetworkManager). main.py starts it at launch
# when MEDIGUARD_HOTSPOT=1. No-op on Windows/without nmcli. Needs sudo on the Pi.
MEDIGUARD_HOTSPOT=1
MEDIGUARD_HOTSPOT_SSID=MediGuard
MEDIGUARD_HOTSPOT_PASSWORD=mediguard123
MEDIGUARD_HOTSPOT_IFACE=wlan0
PLANNER_MODE=online
PLANNING_SERVICE_URL=https://solver.planning.domains:5001/package/lama-first/solve